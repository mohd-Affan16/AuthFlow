<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AuthFlow </title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-cover bg-center bg-no-repeat bg-fixed text-white"
      style="background-image: url('/background_img/background.jpeg');">

  <!-- Main container -->
<div class="min-h-screen flex items-center justify-center p-4 md:p-8">
  
  <!-- Responsive Glassmorphic Card Container -->
  <!-- max-w-md on mobile expands to max-w-2xl on laptops. Padding increases from p-8 to md:p-12 -->
  <div class="relative z-10 max-w-md md:max-w-[650px] md:max-h-[750px]  w-full text-center p-8 md:p-12 rounded-2xl md:rounded-3xl border border-white/20 bg-blue-500/10 backdrop-blur-md shadow-2xl">
    
    <!-- Text sizes scale up on laptops (text-5xl becomes md:text-7xl) -->
    <h1 class="text-5xl md:text-7xl font-bold mb-4 md:mb-6 text-white tracking-tight">
      Welcome to AuthFlow
    </h1>
    
    <!-- Paragraph scales up (text-xl becomes md:text-2xl) -->
    <p class="text-xl md:text-2xl mb-8 md:mb-12 text-white/80">
      Simple and secure login with Google
    </p>
    
    <a href="/auth/google">
      <!-- Button gets wider and text gets larger on laptop screens -->
      <button class="bg-white text-black px-8 py-4 md:px-12 md:py-5 rounded-xl md:rounded-2xl text-lg md:text-xl font-semibold hover:bg-gray-100 transition duration-300 shadow-lg transform hover:-translate-y-0.5 active:translate-y-0">
        Login with Google
      </button>
    </a>

  </div>
</div>

</body>
</html>